{
  "name": "autofeedback-s",
  "version": "1.17.0",
  "description": "A set of actions for autograding assignments with Classroom 50",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "compilerOptions": {
    "target": "esnext", 
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "scripts": {
    "build": "tsc --noEmit && ncc build src/autograding.ts -o dist --target es2023",
    "test": "tsc --noEmit && jest",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "github",
    "education",
    "classroom50",
    "autograding"
  ],
  "author": "David G. Cooper",
  "license": "ISC",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0",
    "@actions/artifact": "^2.1.0",
    "tree-kill": "^1.2.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.2.0",
    "@types/node": "^18.11.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.40.1",
    "@typescript-eslint/parser": "^5.40.1",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.26.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.2.1",
    "nock": "^13.2.9",
    "prettier": "^2.7.1",
    "ts-jest": "^29.0.3",
    "typescript": "^4.8.4"
  }
}
